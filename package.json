{
  "name": "@seo-machine/blog-standard",
  "version": "1.2.0",
  "description": "Blog standard v1: the post format, its checks, and one React renderer, shared by the SEO Machine and every client site.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "bin": {
    "blog-standard": "./dist/cli.js"
  },
  "files": [
    "dist",
    "BLOG_STANDARD.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\""
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^18.0.5",
    "zod": "^4.0.0"
  },
  "keywords": [
    "blog",
    "markdown",
    "nextjs",
    "react",
    "seo"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarioAndresPortilla/blog-standard.git"
  },
  "homepage": "https://github.com/MarioAndresPortilla/blog-standard#readme",
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "tsx": "^4.22.4",
    "@types/node": "^20.19.41",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
